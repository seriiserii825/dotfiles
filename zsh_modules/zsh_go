gU() {
  local steps="$1"

  if [[ -z "$steps" || ! "$steps" =~ ^[0-9]+$ || "$steps" -eq 0 ]]; then
    echo "goUp: pass a positive integer (e.g. goUp 3)" >&2
    return 1
  fi

  local depth=0
  local p="$PWD"
  while [[ "$p" != "/" ]]; do
    depth=$(( depth + 1 ))
    p="${p%/*}"
    [[ -z "$p" ]] && p="/"
  done

  if (( steps > depth )); then
    echo "goUp: can only go up $depth level(s) from here" >&2
    return 1
  fi

  local target="" i
  for (( i = 0; i < steps; i++ )); do
    target+="../"
  done
  cd "$target"
}

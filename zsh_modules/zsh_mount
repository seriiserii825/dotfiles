alias umnt='sudo umount /mnt'

function mnt() {
  TARGET_UUID="bd51a002-3aea-4574-99c0-a98a67753b37"
  MOUNT_POINT="/mnt"

  if findmnt -M "$MOUNT_POINT" >/dev/null; then
    echo "Already mounted: $(findmnt -M "$MOUNT_POINT" -n -o SOURCE | tail -1)"
    cd "$MOUNT_POINT"
    return
  fi

  # udev symlink resolves instantly, unlike blkid which probes every disk
  device=$(readlink -f "/dev/disk/by-uuid/$TARGET_UUID" 2>/dev/null)
  [ -b "$device" ] || device=""

  if [ -n "$device" ]; then
    echo "✅ Found target device: $device"
    sudo mount "$device" "$MOUNT_POINT" && cd "$MOUNT_POINT"
  else
    echo "⚠️ Target device not found. Choose manually."
    lsblk
    devices=$(lsblk -ln -o NAME,TYPE | awk '$2=="part"{print $1}')
    select dev in $devices; do
      sudo mount /dev/$dev "$MOUNT_POINT" && cd "$MOUNT_POINT"
      echo "Mounted to $MOUNT_POINT"
      break
    done
  fi
}

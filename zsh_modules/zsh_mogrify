function showSizes(){
  find . -maxdepth 1 -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.gif" -o -iname "*.webp" \) \
    -exec identify -format "%f | %wx%h\n" {} \; | sort | column -t -s'|'
}

function removeSpaces(){
  perl-rename 's/ /-/g' *
  perl-rename 's/----/-/g' *
  perl-rename 's/---/-/g' *
  perl-rename 's/--/-/g' *
}

JPGTOjpg() {
  for I in *.JPG; 
  do mv "$I" `echo "$I" | sed "s/JPG/jpg/g"`;done
  echo "All JPG files have been converted to jpg."
}


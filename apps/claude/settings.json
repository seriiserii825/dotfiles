{
  "permissions": {
    "allow": [
      "Bash(npx vue-tsc*)",
      "Bash(npx tsc*)",
      "Bash(npx eslint*)",
      "Bash(echo*)"
    ],
    "defaultMode": "auto"
  },
  "enabledPlugins": {
    "figma@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
